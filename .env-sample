# Redis connection URL (used by both agent services)
REDIS_URL=redis://redis:6379/0

# Anthropic API key (for Claude / LLM calls)
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# GitHub App credentials (used for cloning repos & PR automation)
GITHUB_APP_ID=YOUR_GITHUB_APP_ID
GITHUB_APP_PRIVATE_KEY=YOUR_GITHUB_APP_PRIVATE_KEY
GITHUB_INSTALLATION_ID=YOUR_GITHUB_INSTALLATION_ID

# Test timeout (matches the value in deployment.yaml)
TEST_TIMEOUT_SECONDS=300

TEST_VALUE=null