# Redis connection URL (used by both agent services)
REDIS_URL=redis://redis:6379/0

# Anthropic API key (for Claude / LLM calls)
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# GitHub App credentials (used for cloning repos & PR automation)
GITHUB_APP_ID=YOUR_GITHUB_APP_ID
GITHUB_APP_PRIVATE_KEY=YOUR_GITHUB_APP_PRIVATE_KEY
GITHUB_INSTALLATION_ID=YOUR_GITHUB_INSTALLATION_ID

# Test timeout (matches the value in deployment.yaml)
TEST_TIMEOUT_SECONDS=300


gcloud iam workload-identity-providers create github-provider   --location=global   --workload-identity-pool=github-pool   --display-name="GitHub OIDC provider"   --attribute-mapping="google.subject=^https://github.com/(.+)$"
   64  gcloud iam workload-identity-pools providers create-oidc "github-provider"   --project="pre-bug-fix-agent"   --location="global"   --workload-identity-pool="github-pool"   --display-name="GitHub OIDC provider"   --issuer-uri="https://githubusercontent.com"   --attribute-mapping="google.subject=assertion.sub,attribute.repository=assertion.repository,attribute.actor=assertion.actor"